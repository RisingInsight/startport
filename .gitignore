# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/starport
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/
.gocache/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
.zcodeignore
LOOP.md
PLAN.md
SPEC.md

# 设计/计划文档（但 README 与 docs/ 下的公开文档必须进版本库）
*.md
!README.md
!README.*.md
!docs/*.md

# 本地材料：评审报告 / 资助申请材料（含个人与账号信息，禁止入库）
deliverables/gstack/

# Windows binaries
/wb2api.exe
/starport.exe
/starport.exe~
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store
