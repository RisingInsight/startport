{
  "listen": "127.0.0.1:7863",
  "api_key": "",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "server": {
    "read_timeout": "300s",
    "max_body_mb": 0,
    "trusted_proxies": []
  },
  "panel": {
    "package_detail_limit": 5
  },
  "logging": {
    "request_archive_enabled": true,
    "request_retention_days": 7,
    "request_archive_max_mb": 100,
    "request_client_info": true
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [
      9,
      21
    ],
    "growth_hours": [
      1
    ],
    "travel_hours": [
      9,
      21
    ],
    "activity_hours": [
      10
    ],
    "keepalive_hours": [
      22
    ],
    "blackcat_hours": [
      23
    ],
    "checkin_enabled": true,
    "growth_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true,
    "blackcat_enabled": true,
    "balance_refresh_enabled": true,
    "balance_refresh_minutes": 5,
    "include_disabled_in_tasks": false
  },
  "global": {
    "enabled": true,
    "chat_base": "",
    "billing_base": ""
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "client_name": "",
    "device_token": "",
    "device_token_file": "",
    "passthrough_ip": false
  },
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "prompt": {
    "mode": "passthrough",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "max_in_flight": 3,
    "max_in_flight_global": 2,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "degrade_threshold": 5,
    "degrade_cooldown": "10m",
    "degrade_cooldown_max": "2h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0,
    "prefer_expiring": true,
    "expiring_soon": "168h",
    "cost_explore_interval": "30m",
    "credit_floor": 100
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  },
  "update": {
    "check_enabled": true,
    "check_interval_hours": 6
  },
  "ext_channels": [
    {
      "name": "siliconflow",
      "base_url": "https://api.siliconflow.cn",
      "api_key": "",
      "models": [],
      "disabled": true,
      "timeout_seconds": 0,
      "allow_private": false
    },
    {
      "name": "gemini-example",
      "base_url": "https://generativelanguage.googleapis.com",
      "protocol": "gemini",
      "path": "",
      "auth": { "mode": "custom", "header": "x-goog-api-key" },
      "headers": {},
      "models": ["gemini-2.0-flash"],
      "aliases": { "fast": "gemini-2.0-flash-8b" },
      "note": "示例：多凭证 + 别名 + 自定义鉴权（默认停用；把 secret 换成你自己的 key 再启用）",
      "credentials": [
        { "label": "primary", "secret": "REPLACE_WITH_YOUR_KEY", "expires_at": "" },
        { "label": "backup", "secret": "REPLACE_WITH_YOUR_KEY", "disabled": true }
      ],
      "api_key": "",
      "disabled": true,
      "timeout_seconds": 0,
      "allow_private": false
    },
    {
      "name": "loomy",
      "base_url": "https://loomyad.xunfei.cn/api/v1",
      "protocol": "openai",
      "adapter": "loomy",
      "path": "",
      "models": [],
      "aliases": {},
      "note": "示例：原生适配器（adapter=loomy）。凭证填 Loomy 客户端登录态里的 session（14 天、无续期）；token 与 Authorization 双头由适配器自动注入，因此不要配 auth。默认停用。",
      "credentials": [
        { "label": "primary", "secret": "REPLACE_WITH_LOOMY_SESSION", "expires_at": "" }
      ],
      "api_key": "",
      "disabled": true,
      "timeout_seconds": 0,
      "allow_private": false
    },
    {
      "name": "autoclaw",
      "base_url": "https://autoglm-acceleration-api.zhipuai.cn/autoclaw-proxy/proxy/autoclaw",
      "protocol": "openai",
      "adapter": "autoclaw",
      "path": "",
      "models": ["glm-5.3", "glm-5.3-flash"],
      "aliases": {},
      "note": "示例：原生适配器（adapter=autoclaw，国内版）。凭证填桌面端 openclaw.json 里 X-Authorization 的 token（401 即失效需重取）；system 会包进 OpenClaw 身份前缀、max_tokens 小值归一到 10000。国际版把 adapter 换成 autoclaw-intl 并换 base。默认停用。",
      "credentials": [
        { "label": "primary", "secret": "REPLACE_WITH_AUTOCLAW_TOKEN", "expires_at": "" }
      ],
      "api_key": "",
      "disabled": true,
      "timeout_seconds": 0,
      "allow_private": false
    }
  ],
  "ext_intel": {
    "enabled": true,
    "url": "https://token-fbi.com/data.json",
    "interval_hours": 12
  }
}
